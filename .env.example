# 复制为 .env 并填入真实值（.env 勿提交 Git）
# Windows: copy .env.example .env
# Linux/Mac: cp .env.example .env

# ========== MySQL ==========
DB_URL=jdbc:mysql://localhost:3306/web_demo?characterEncoding=utf8&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# ========== 阿里云号码认证 / 短信验证码（控制台需开通 SendSmsVerifyCode）==========
# AccessKey 需有 dypns 权限；SignName、SchemeName、TemplateCode 须与控制台一致
ALIYUN_ACCESS_KEY_ID=your_access_key_id
# Secret 固定 30 位，勿加引号、勿留空格或换行
ALIYUN_ACCESS_KEY_SECRET=your_30_char_access_key_secret_here
ALIYUN_SMS_SIGN_NAME=速通互联验证码
ALIYUN_SMS_TEMPLATE_CODE=100001
ALIYUN_SMS_SCHEME_NAME=测试方案
ALIYUN_SMS_TEMPLATE_PARAM={"code":"##code##","min":"5"}

# ========== 邮箱 SMTP（找回密码）==========
MAIL_SENDER_EMAIL=your_email@example.com
MAIL_SMTP_AUTH_CODE=your_smtp_auth_code
MAIL_SMTP_HOST=smtp.qq.com
MAIL_SMTP_PORT=587

# ========== Android App（可选，mobile 目录构建用）==========
# APP_SERVER_URL=http://192.168.1.100:8080
