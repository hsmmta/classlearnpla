@echo off
REM 复制为 Tomcat bin\setenv.bat，或在启动 Tomcat 前 source 本文件
REM 也可在项目根目录使用 .env（由 EnvUtil 自动加载）

set DB_URL=jdbc:mysql://127.0.0.1:3306/web_demo?characterEncoding=utf8^&allowPublicKeyRetrieval=true^&useSSL=false
set DB_USERNAME=your_db_user
set DB_PASSWORD=your_db_password

set ALIYUN_ACCESS_KEY_ID=your_access_key_id
set ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret

set MAIL_SENDER_EMAIL=your_email@example.com
set MAIL_SMTP_AUTH_CODE=your_smtp_auth_code
